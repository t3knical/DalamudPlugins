{
  "$comment": "Source map for Update-Repo.ps1. Paths are relative to the repo root. Sources live outside this repo; only built zips are published here.",
  "baseUrl": "https://raw.githubusercontent.com/t3knical/DalamudPlugins/main",
  "repoUrl": "https://github.com/t3knical/DalamudPlugins",
  "plugins": [
    {
      "internalName": "HunterV2",
      "project": "../Hunter.v2/Hunter.csproj"
    },
    {
      "internalName": "PingWatcher",
      "project": "../Tekz Ping Checker/PingPlugin/PingPlugin.csproj",
      "license": "../Tekz Ping Checker/LICENSE",
      "fork": {
        "upstream": "https://github.com/karashiiro/PingPlugin",
        "author": "karashiiro",
        "license": "MIT"
      }
    },
    {
      "internalName": "PartyMonitor",
      "project": "../Party Monitor/PartyMonitor/PartyMonitor.csproj",
      "$comment": "TempScraper is a separate console process (Selenium) that Party Monitor launches to read Tomestone.gg. DalamudPackager does not carry subfolders, so it is bundled explicitly.",
      "payload": [
        {
          "source": "../Party Monitor/TempScraper/bin/Release/net10.0",
          "target": "TempScraper",
          "exclude": [
            "*.pdb",
            "*.log",
            "*debug*",
            "*_rendered.html"
          ]
        }
      ]
    },
    {
      "internalName": "PartyRecruitmentHelper",
      "project": "../PartyRecruitmentHelper/PartyRecruitmentHelper/PartyRecruitmentHelper.csproj"
    },
    {
      "internalName": "BeastMasterHelper",
      "project": "../BeastMasterHelper/BeastMasterHelper.csproj",
      "$comment": "English fork of Anmi's Beastmaster. Upstream states NO licence, so redistribution terms are unstated - published with prominent attribution and withdrawn on request. See ../BeastMasterHelper/NOTICE.md.",
      "fork": {
        "upstream": "https://github.com/anmili2022/Beastmaster",
        "author": "Anmi",
        "license": "none stated"
      }
    },
    {
      "internalName": "BossModRebornTekz",
      "project": "../BossmodReborn/BossMod/BossModReborn.csproj",
      "license": "../BossmodReborn/LICENSE",
      "$comment": "Fork of BossMod Reborn, itself a fork of veyn's BossMod. BSD-3-Clause, so redistribution is fine provided the notice travels and the original authors are not used to endorse this build - hence the renamed InternalName and the 'unofficial fork' wording in the manifest.",
      "fork": {
        "upstream": "https://github.com/FFXIV-CombatReborn/BossmodReborn",
        "author": "The Combat Reborn Team",
        "license": "BSD-3-Clause"
      }
    },
    {
      "internalName": "OccultHelper",
      "project": "../OccultHelper.v2/OccultHelper/OccultHelper.csproj",
      "license": "../OccultHelper.v2/LICENSE",
      "fork": {
        "upstream": "https://github.com/OhKannaDuh/OccultHelper",
        "author": "OhKannaDuh",
        "license": "AGPL-3.0"
      }
    },
    {
      "internalName": "ReactionHelper",
      "project": "../ReactionHelper/ReactionHelper.csproj",
      "$comment": "Ships the Crucible timelines and Beastmaster profiles in Bundled/; the plugin copies them into its config folder on startup (never over a file the user edited).",
      "payload": [
        {
          "source": "../ReactionHelper/Bundled",
          "target": "Bundled"
        }
      ]
    }
  ]
}
