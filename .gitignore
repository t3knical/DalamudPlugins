# Maintainer-only documentation - kept local, never published to the GitHub page.
INSTRUCTIONS.md

# Packaged plugins are distributed as GitHub Release assets, not committed.
# Keeping binaries out of git avoids permanently bloating history and is what
# makes per-asset download counts possible.
plugins/*/latest.zip

# Build artifacts
bin/
obj/
*.user
*.suo

# IDE / tooling state (may contain local paths)
.vs/
.idea/
.vscode/
.claude/

# Local machine settings - never publish
*.local.json
settings.local.json
.env
.env.*
secrets.json
appsettings.Development.json

# Plugin configs (can contain tokens, character data)
pluginConfigs/
*.pluginconfig.json

# Logs / scratch
*.log
logs/
graphify-out/
